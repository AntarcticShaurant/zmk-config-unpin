               display-name = "AERO";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │ Workspace 1  │ Workspace 2  │ Workspace 3  │ Workspace 4  │ Workspace 5  │                              │ Workspace 6  │ Workspace 7  │ Workspace 8  │ Workspace 9  │ Workspace 10 │              │
                    &trans         &kp LA(LC(N1)) &kp LA(LC(N2)) &kp LA(LC(N3)) &kp LA(LC(N4)) &kp LA(LC(N5))                                &kp LA(LC(N6)) &kp LA(LC(N7)) &kp LA(LC(N8)) &kp LA(LC(N9)) &kp LA(LC(N0)) &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ TOGGLE WSPACE│ TOGGLE WSPACE│ PREV WSPACE  │ NEXT WSPACE  │ AERO RESIZE  │              │                              │              │ SHIFT LEFT   │ ↑            │              │              │              │
                    &kp LA(LC(TAB)) &kp LA(LC(TAB)) &kp LA(LC(W)) &kp LA(LC(E)) &mo AERO_R     &none                                         &none          &kp LSHFT      &kp LA(LC(UP)) &none          &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ (HELD)       │ LOCK         │ SHIFT LEFT   │ CMD LEFT     │ FULLSCREEN   │              │                              │ CMD LEFT     │ ←            │ ↓            │ →            │ Menu         │              │
                    &trans         &tog AERO_L    &kp LSHFT      &kp LGUI       &kp LA(LC(F))  &none                                         &kp LGUI     &kp LA(LC(LEFT)) &kp LA(LC(DOWN)) &kp LA(LC(RIGHT)) &kp LA(LC(SEMI))    &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │ FLOATING/TILING             │              ││              │ Workspace 1  │ Workspace 2  │ Workspace 3  │ Workspace 4  │ Workspace 5  │              │
                    &none          &none          &none          &none          &kp LS(LA(LC(F)))     &none   &none           &none          &kp LA(LC(N1)) &kp LA(LC(N2)) &kp LA(LC(N3)) &kp LA(LC(N4)) &kp LA(LC(N5)) &none
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │              │ LAUNCH MODE  ││ ALFRED       │              │              │              │              │
                                                  &none          &none          &none          &none   &kp LS(LA(LC(SPACE)))  &kp LA(LC(SPACE))     &none   &none          &none          &none
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          aero_locked_layer {
               display-name = "AERO";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │ Workspace 1  │ Workspace 2  │ Workspace 3  │ Workspace 4  │ Workspace 5  │                              │ Workspace 6  │ Workspace 7  │ Workspace 8  │ Workspace 9  │ Workspace 10 │              │
                    &trans         &kp LA(LC(N1)) &kp LA(LC(N2)) &kp LA(LC(N3)) &kp LA(LC(N4)) &kp LA(LC(N5))                                &kp LA(LC(N6)) &kp LA(LC(N7)) &kp LA(LC(N8)) &kp LA(LC(N9)) &kp LA(LC(N0)) &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ TOGGLE WSPACE│ TOGGLE WSPACE│ PREV WSPACE  │ NEXT WSPACE  │ AERO RESIZE  │              │                              │              │ SHIFT LEFT   │ ↑            │              │              │              │
                    &kp LA(LC(TAB)) &kp LA(LC(TAB)) &kp LA(LC(W)) &kp LA(LC(E)) &mo AERO_R     &none                                         &none          &kp LSHFT      &kp LA(LC(UP)) &none          &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ UNLOCK       │ UNLOCK       │ SHIFT LEFT   │ CMD LEFT     │ FULLSCREEN   │              │                              │ CMD LEFT     │ ←            │ ↓            │ →            │ Menu         │              │
                    &tog AERO_L    &tog AERO_L    &kp LSHFT      &kp LGUI       &kp LA(LC(F))  &none                                         &kp LGUI     &kp LA(LC(LEFT)) &kp LA(LC(DOWN)) &kp LA(LC(RIGHT)) &kp LA(LC(SEMI))    &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │ FLOATING/TILING             │              ││              │ Workspace 1  │ Workspace 2  │ Workspace 3  │ Workspace 4  │ Workspace 5  │              │
                    &none          &none          &none          &none          &kp LS(LA(LC(F)))     &none   &none           &none          &kp LA(LC(N1)) &kp LA(LC(N2)) &kp LA(LC(N3)) &kp LA(LC(N4)) &kp LA(LC(N5)) &none
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │              │ LAUNCH MODE  ││ ALFRED       │              │              │              │              │
                                                  &none          &none          &none          &none   &kp LS(LA(LC(SPACE)))  &kp LA(LC(SPACE))     &none   &none          &none          &none
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          aero_resize_layer {
               display-name = "RESIZE";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
                    &trans         &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │ BIG RESIZE   │ (HELD)       │              │                              │                BALANCE SIZE │ ↑            │ FLATTEN TREE │              │              │
                    &none          &none          &none          &kp LSHFT      &trans         &none                                         &none        &kp LA(LC(F20))  &kp LA(LC(F18)) &kp LS(LA(LC(F20)))  &none   &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ (HELD)       │              │              │              │              │              │                              │              │ ←            │ ↓            │ →            │              │              │
                    &trans         &none          &none          &none          &none          &none                                         &none        &kp LA(LC(F16)) &kp LA(LC(F19)) &kp LA(LC(F17))       &none   &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │              │              │              ││              │              │              │              │              │              │              │
                    &none          &none          &none          &none          &none          &none          &none           &none          &none          &none          &none          &none          &none          &none
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │              │              ││              │              │              │              │              │
                                                  &none          &none          &none          &none          &none           &none          &none          &none          &none          &none
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          service_layer {
               display-name = "SERVICE";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │ BLUETOOTH 1  │ BLUETOOTH 2  │ BLUETOOTH 3  │ BLUETOOTH 4  │ BLUETOOTH 5  │                              │              │              │              │              │              │ BT CLEAR     │
                    &none          &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                                  &none          &none          &none          &none          &none          &bt BT_CLR
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │              │              │                              │ RGB TOGGLE   │ BRI DOWN     │ BRI UP       │ ANIM PREV    │ ANIM NEXT    │              │
                    &none          &none          &none          &none          &none          &none                                        &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_EFR &rgb_ug RGB_EFF    &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ (UN)LOCK     │              │              │              │              │              │                              │              │ HUE DOWN     │ HUE UP       │ SPEED DOWN   │ SPEED UP     │              │
                    &tog SERV      &none          &none          &none          &none          &none                                         &none         &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SPD &rgb_ug RGB_SPI     &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │              │              │              ││ ZMK Studio Unlock           │ SAT DOWN     │ SAT UP       │              │              │              │
                    &none          &none          &none          &none          &none          &none          &none           &studio_unlock &none          &rgb_ug RGB_SAD &rgb_ug RGB_SAI &none        &none          &none
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │ (HELD)       │              ││              │ (HELD)       │              │              │              │
                                                  &none          &none          &none          &trans         &none           &none          &trans         &none          &none          &none
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };
     };
};
