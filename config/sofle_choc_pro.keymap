#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define MAIN     0
#define S_DORI   1
#define S_CODE   2
#define NAV      3
#define NAV_M    4
#define SYMB     5
#define EMOJIS   6
#define FUNC1    7
#define FUNC2    8
#define MCRS     9
#define M_LOGIC  10
#define M_DORI   11
#define M_CODE   12
#define AERO     13
#define AERO_R   14
#define SERV     15

/ {

  behaviors {
      // Layer Buttons
      // Hold = Momentary Layer (&mo) | Tap = Sticky Layer (&sl)
      l_ht: layer_hold_tap {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "hold-preferred";
          tapping-term-ms = <200>;
          retro-tap;
          bindings = <&mo>, <&sl>;
      };

      // Aerospace
      aero: aero_hold_tap {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <0>;
          flavor = "hold-preferred";
          tapping-term-ms = <200>;
          bindings = <&mo AERO &kp ESC>;
      };

      // Macros
      mht: macro_hold_tap {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "hold-preferred";
          tapping-term-ms = <200>;
          bindings = <&mo>, <&sl>;
      };

      // Top Row Tap Dance
      tr_td: top_row_tap_dance {
          compatible = "zmk,behavior-tap-dance";
          #binding-cells = <0>;
          tapping-term-ms = <250>;
          // 1: Sleep, 2: Emojis, 3: Func-Keys 1-10, 4: Func-Keys 11-20, 5: Service Layer
          bindings = <&kp C_SLEEP>, <&tog EMOJIS>, <&tog FUNC1>, <&tog FUNC2>, <&tog SERV>;
      };
  };

  // Activate SERVICE layer by pressing both NAV and SYMB
  conditional_layers {
    compatible = "zmk,conditional-layers";
    adjust_layer {
      if-layers = <NAV SYMB>;
      then-layer = <SERV>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    main_layer {
      display-name = "MAIN";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │ TR TAP DANCE │ 1            │ 2            │ 3            │ 4            │ 5            │                              │ 6            │ 7            │ 8            │ 9            │ 0            │ ß            │
           &tr_td         &kp N1         &kp N2         &kp N3         &kp N4         &kp N5                                        &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp MINUS
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │ TAB          │ Q            │ W            │ E            │ R            │ T            │                              │ Z            │ U            │ I            │ O            │ P            │ Ü            │
           &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T                                         &kp Y          &kp U          &kp I          &kp O          &kp P          &kp LBKT
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │ ESC / AERO   │ A            │ S            │ D            │ F            │ G            │                              │ H            │ J            │ K            │ L            │ Ö            │ Ä            │
           &aero          &kp A          &kp S          &kp D          &kp F          &kp G                                         &kp H          &kp J          &kp K          &kp L          &kp SEMI       &kp SQT
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │ SHIFT Left   │ Y            │ X            │ C            │ V            │ B            │ MACROS       ││ ENTER        │ N            │ M            │ ,            │ .            │ -            │ SHIFT Right  │
           &kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &mht MCRS M_LOGIC &kp RET      &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
      // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
      //                               │ CTRL Left    │ OPT Left     │ CMD Left     │ NAV          │ BACKSPACE    ││ SPACE        │ SYMBOLS      │ CMD Right    │ OPT Right    │ CTRL Right   │
                                         &kp LCTRL      &kp LALT       &kp LGUI       &l_ht NAV NAV  &kp BSPC        &kp SPACE      &l_ht SYMB SYMB  &kp RGUI     &kp RALT       &kp RCTRL
      //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      >;
    };

    macro_overlay_dorico_layer {
      display-name = "MAIN";
      bindings = <
          &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
          &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
          &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
          &trans &trans &trans &trans &trans &trans &mht MCRS M_DORI &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans
      >;
    };

    macro_overlay_coding_layer {
      display-name = "MAIN";
      bindings = <
          &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
          &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
          &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
          &trans &trans &trans &trans &trans &trans &mht MCRS M_CODE &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans
      >;
    };

    nav_layer {
      display-name = "NAV";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │              │ BRIGHTN DOWN │ BRIGHTN UP   │KB LI TOGGLE    KB LI DOWN   │ KB LI UP     │                              │              │              │              │              │              │              │
           &trans         &kp C_BRI_DN   &kp C_BRI_UP  &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI                              &none          &none          &none          &none          &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │ REWIND       │ PREVIOUS     │ PLAY/PAUSE   │ NEXT         │ FAST FWD     │                              │ Page Up      │ Home         │ ↑            │ End          │              │              │
           &trans         &kp C_RW       &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp C_FF                                      &kp PG_UP      &kp HOME       &kp UP         &kp END        &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │ OPT Left     │ SHIFT Left   │ CMD Left     │ MOUSE CTRL   │              │                              │ Page Down    │ ←            │ ↓            │ →            │              │              │
           &trans         &kp LALT       &kp LSHFT      &kp LGUI       &mo NAV_M      &none                                         &kp PG_DN      &kp LEFT       &kp DOWN       &kp RIGHT      &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │ MUTE         │ VOL DOWN     │ VOL UP       │              │ LOCK NAV     ││              │ Prev         │ Prev Tab     │              │ Next Tab     │ Next         │              │
           &trans         &none          &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &none          &tog NAV        &trans         &kp LG(LEFT)   &kp LC(LS(TAB)) &none         &kp LC(TAB)    &kp LG(RIGHT)  &trans
      // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
      //                               │              │              │              │ (HELD)       │ DELETE       ││              │              │              │              │              │
                                         &trans         &trans         &trans         &trans         &kp DEL         &trans         &trans         &trans         &trans         &trans
      //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      >;
    };

    nav_mouse_layer {
      display-name = "MOUSE";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
           &trans         &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │              │              │              │              │                              │ ↑ SCROLL     │ ← SCROLL     │ ↑ MOVE       │ → SCROLL     │              │              │
           &trans         &none          &none          &none          &none          &none                                         &msc SCRL_UP   &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT       &none   &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │ OPT Left     │ SHIFT Left   │ CMD Left     │ (HELD)       │              │                              │ ↓ SCROLL     │ ← MOVE       │ ↓ MOVE       │ → MOVE       │              │              │
           &trans         &kp LALT       &kp LSHFT      &kp LGUI       &trans         &none                                         &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT       &none   &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │              │              │              │              │              ││              │ MB4 (BACK)   │ LEFT CLICK   │ MIDDLE CLICK │ RIGHT CLICK  │ MB5 (FWD)    │              │
           &trans         &none          &none          &none          &none          &none          &none           &trans         &mkp MB4       &mkp LCLK      &mkp MCLK      &mkp RCLK      &mkp MB5       &trans
      // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
      //                               │              │              │              │ (HELD)       │              ││              │              │              │              │              │
                                         &trans         &trans         &trans         &trans         &none           &trans         &trans         &trans         &trans         &trans
      //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      >;
    };

    symbol_layer {
      display-name = "SYMBOLS";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │              │              │              │              │              │              │                              │              │              │              │              │              │ °            │
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &kp LS(GRAVE)
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │ §            │ $            │ €            │ `            │ ´            │                              │ ©            │ /            │ |            │ \            │ —            │ ^            │
           &trans         &kp LS(N3)     &kp LS(N4)     &kp LA(E)      &kp LS(EQUAL)  &kp EQUAL                                     &kp LA(G)      &kp LS(N7)     &kp LA(N7)     &kp LS(LA(N7)) &kp LS(LA(FSLH)) &kp GRAVE
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │ @            │ ?            │ !            │ "            │ '            │                              │ ~            │ &            │ +            │ =            │ %            │ #            │
           &trans         &kp LA(L)      &kp LS(MINUS)  &kp LS(N1)     &kp LS(N2)     &kp LS(BSLH)                                  &kp LA(N)      &kp LS(N6)     &kp RBKT       &kp LS(N0)     &kp LS(N5)     &kp BSLH
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │ _            │ [            │ {            │ (            │ <            │ LOCK SYMB    ││              │ >            │ )            │ }            │ ]            │ *            │              │
           &trans         &kp LS(FSLH)   &kp LA(N5)    &kp LA(N8)     &kp LS(N8)     &kp NON_US_BSLH &tog SYMB       &trans   &kp LS(NON_US_BSLH)  &kp LS(N9)     &kp LA(N9)     &kp LA(N6)     &kp LS(RBKT)   &trans
      // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
      //                               │              │              │              │              │              ││              │ (HELD)       │              │              │              │
                                         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
      //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      >;
    };

    emoji_layer {
      display-name = "EMOJIS";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │ Exit Emojis  │ 😊           │ 🤗            │ 😂           │ 😅           │ 🥲            │                              │ ❤️           │ 😍           │ 👍🏻            │ 🙈           │ 🤔           │ GLOBE        │
           &tog EMOJIS    &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
           &trans         &trans         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans         &trans         &trans
                                         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
      >;
    };

    function1_layer {
      display-name = "FUNC 1-10";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │ Exit FUNC1   │ F1           │ F2           │ F3           │ F4           │ F5           │                              │ F6           │ F7           │ F8           │ F9           │ F10          │              │
           &tog FUNC1     &kp F1         &kp F2         &kp F3         &kp F4         &kp F5                                        &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &trans
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
           &trans         &trans         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans         &trans         &trans
                                         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
      >;
    };

    function2_layer {
      display-name = "FUNC 11-20";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │ Exit FUNC2   │ F11          │ F12          │ F13          │ F14          │ F15          │                              │ F16          │ F17          │ F18          │ F19          │ F20          │              │
           &tog FUNC2     &kp F11        &kp F12        &kp F13        &kp F14        &kp F15                                       &kp F16        &kp F17        &kp F18        &kp F19        &kp F20        &trans
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
           &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
           &trans         &trans         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans         &trans         &trans
                                         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
      >;
    };

    macros_select_layer {
      display-name = "MACROS SELECT";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
           &none          &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
           &none          &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │ DORICO       │              │              │              │                              │              │              │              │ LOGIC        │              │              │
           &none          &none          &to S_DORI     &none          &none          &none                                         &none          &none          &none          &to MAIN       &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │              │ CODING       │              │              │ (Held)       ││              │              │              │              │              │              │              │
           &none          &none          &none          &to S_CODE     &none          &none          &trans          &none          &none          &none          &none          &none          &none          &none
      // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
      //                               │              │              │              │              │              ││              │              │              │              │              │
                                         &none          &none          &none          &none          &none           &none          &none          &none          &none          &none
      //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      >;
    };

     macros_logic_layer {
      display-name = "LOGIC";
      bindings = <
      // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
      // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
           &none          &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
           &none          &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
      // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
      // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
           &none          &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
