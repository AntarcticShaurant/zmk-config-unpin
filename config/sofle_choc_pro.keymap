#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define MAIN      0
#define S_DORI    1
#define S_CODE    2
#define NAV       3
#define NAV_L     4
#define NAV_M     5
#define SYMB      6
#define SYMB_L    7
#define EMOJIS    8
#define FUNC1     9
#define FUNC2     10
#define MCRS      11
#define M_LOGIC   12
#define M_LOGIC_L 13
#define M_DORI    14
#define M_DORI_L  15
#define M_CODE    16
#define M_CODE_L  17
#define AERO      18
#define AERO_L    19
#define AERO_R    20
#define SERV      21

#include "macros.dtsi"
#include "custom_behaviors.dtsi"

/ {
     // Activate SERVICE layer by pressing both NAV and SYMB
     conditional_layers {
          compatible = "zmk,conditional-layers";
          adjust_layer {
               if-layers = <NAV SYMB>;
               then-layer = <SERV>;
          };
     };

     keymap {
          compatible = "zmk,keymap";

          main_layer {
               display-name = "MAIN";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │ TR TAP DANCE │ 1            │ 2            │ 3            │ 4            │ 5            │                              │ 6            │ 7            │ 8            │ 9            │ 0            │ ß            │
                    &tr_td         &kp N1         &kp N2         &kp N3         &kp N4         &kp N5                                        &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp MINUS
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ TAB          │ Q            │ W            │ E            │ R            │ T            │                              │ Z            │ U            │ I            │ O            │ P            │ Ü            │
                    &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T                                         &kp Y          &kp U          &kp I          &kp O          &kp P          &kp LBKT
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ ESC / AERO   │ A            │ S            │ D            │ F            │ G            │                              │ H            │ J            │ K            │ L            │ Ö            │ Ä            │
                    &as_t AERO ESC &kp A          &kp S          &kp D          &kp F          &kp G                                         &kp H          &kp J          &kp K          &kp L          &kp SEMI       &kp SQT
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ SHIFT Left   │ Y            │ X            │ C            │ V            │ B            │ MACROS       ││ ENTER        │ N            │ M            │ ,            │ .            │ -            │ SHIFT Right  │
                    &kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &mht MCRS M_LOGIC &kp RET      &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │ CTRL Left    │ OPT Left     │ CMD Left     │ NAV          │ BACKSPACE    ││ SPACE        │ SYMBOLS      │ CMD Right    │ OPT Right    │ CTRL Right   │
                                                  &kp LCTRL      &kp LALT       &kp LGUI       &l_ht NAV NAV  &kp BSPC        &kp SPACE      &l_ht SYMB SYMB  &kp RGUI     &kp RALT       &kp RCTRL
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          macro_overlay_dorico_layer {
               display-name = "MAIN";
               bindings = <
                  &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &trans &trans &trans &mht MCRS M_DORI &trans &trans &trans &trans &trans &trans &trans
                                &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans
               >;
          };

          macro_overlay_coding_layer {
               display-name = "MAIN";
               bindings = <
                  &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &trans &trans &trans                         &trans &trans &trans &trans &trans &trans
                  &trans &trans &trans &trans &trans &trans &mht MCRS M_CODE &trans &trans &trans &trans &trans &trans &trans
                                &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans
               >;
          };

          nav_layer {
               display-name = "NAV";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │ BRIGHTN DOWN │ BRIGHTN UP   │KB LI TOGGLE    KB LI DOWN   │ KB LI UP     │                              │              │              │              │              │              │              │
                    &trans         &kp C_BRI_DN   &kp C_BRI_UP  &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI                              &none          &none          &none          &none          &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ REWIND       │ PREVIOUS     │ PLAY/PAUSE   │ NEXT         │ FAST FWD     │                              │ Page Up      │ Home         │ ↑            │ End          │              │              │
                    &trans         &kp C_RW       &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp C_FF                                      &kp PG_UP      &kp HOME       &kp UP         &kp END        &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ LOCK/AERO    │ OPT Left     │ SHIFT Left   │ CMD Left     │ CTRL Left    │ MOUSE CTRL   │                              │ Page Down    │ ←            │ ↓            │ →            │              │              │
                    &as_l AERO NAV_L &kp LALT     &kp LSHFT      &kp LGUI       &kp LCTRL      &mo NAV_M                                     &kp PG_DN      &kp LEFT       &kp DOWN       &kp RIGHT      &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │ MUTE         │ VOL DOWN     │ VOL UP       │              │              ││              │ Prev         │ Prev Tab     │              │ Next Tab     │ Next         │              │
                    &trans         &none          &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &none          &trans          &trans         &kp LG(LEFT)   &kp LC(LS(TAB)) &none         &kp LC(TAB)    &kp LG(RIGHT)  &trans
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │ (HELD)       │ DELETE       ││              │              │              │              │              │
                                                  &trans         &trans         &trans         &trans         &kp DEL         &trans         &trans         &trans         &trans         &trans
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          nav_locked_layer {
               display-name = "NAV";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │ BRIGHTN DOWN │ BRIGHTN UP   │KB LI TOGGLE    KB LI DOWN   │ KB LI UP     │                              │              │              │              │              │              │              │
                    &trans         &kp C_BRI_DN   &kp C_BRI_UP  &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI                              &none          &none          &none          &none          &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ REWIND       │ PREVIOUS     │ PLAY/PAUSE   │ NEXT         │ FAST FWD     │                              │ Page Up      │ Home         │ ↑            │ End          │              │              │
                    &trans         &kp C_RW       &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp C_FF                                      &kp PG_UP      &kp HOME       &kp UP         &kp END        &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ UNLOCK/AERO  │ OPT Left     │ SHIFT Left   │ CMD Left     │ CTRL Left    │ MOUSE CTRL   │                              │ Page Down    │ ←            │ ↓            │ →            │              │              │
                    &as_l AERO NAV_L &kp LALT     &kp LSHFT      &kp LGUI       &kp LCTRL      &mo NAV_M                                     &kp PG_DN      &kp LEFT       &kp DOWN       &kp RIGHT      &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │ MUTE         │ VOL DOWN     │ VOL UP       │              │              ││              │ Prev         │ Prev Tab     │              │ Next Tab     │ Next         │              │
                    &trans         &none          &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &none          &trans          &trans         &kp LG(LEFT)   &kp LC(LS(TAB)) &none         &kp LC(TAB)    &kp LG(RIGHT)  &trans
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │ (HELD)       │ DELETE       ││              │              │              │              │              │
                                                  &trans         &trans         &trans         &trans         &kp DEL         &trans         &trans         &trans         &trans         &trans
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          nav_mouse_layer {
               display-name = "MOUSE";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │              │              │              │              │              │                              │              │              │              │              │              │              │
                    &trans         &none          &none          &none          &none          &none                                         &none          &none          &none          &none          &none          &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │              │              │                              │ ↑ SCROLL     │ ← SCROLL     │ ↑ MOVE       │ → SCROLL     │              │              │
                    &none          &none          &none          &none          &none          &none                                         &msc SCRL_DOWN &msc SCRL_RIGHT &mmv MOVE_UP   &msc SCRL_LEFT       &none   &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ OPT Left     │ SHIFT Left   │ CMD Left     │ CTRL Left    │ (HELD)       │                              │ ↓ SCROLL     │ ← MOVE       │ ↓ MOVE       │ → MOVE       │              │              │
                    &trans         &kp LALT       &kp LSHFT      &kp LGUI       &kp LCTRL      &none                                         &msc SCRL_UP   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT       &none   &none
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │              │              │              │              │              │              ││              │ MB4 (BACK)   │ LEFT CLICK   │ MIDDLE CLICK │ RIGHT CLICK  │ MB5 (FWD)    │              │
                    &trans         &none          &none          &none          &none          &none          &none           &trans         &mkp MB4       &mkp LCLK      &mkp MCLK      &mkp RCLK      &mkp MB5       &trans
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │ (HELD)       │              ││              │              │              │              │              │
                                                  &trans         &trans         &trans         &trans         &none           &trans         &trans         &trans         &trans         &trans
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          symbol_layer {
               display-name = "SYMBOLS";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │              │              │              │              │              │                              │              │              │              │              │              │ °            │
                    &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &kp LS(NON_US_BSLH)
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ §            │ $            │ €            │ `            │ ´            │                              │ ©            │ /            │ |            │ \            │ —            │ _            │
                    &trans         &kp LS(N3)     &kp LS(N4)     &kp LA(E)      &kp LS(EQUAL)  &kp EQUAL                                     &kp LA(G)      &kp LS(N7)     &kp LA(N7)     &kp LS(LA(N7)) &kp LS(LA(FSLH)) &kp LS(FSLH)
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ LOCK/AERO    │ @            │ ?            │ !            │ "            │ '            │                              │ ~            │ &            │ +            │ =            │ %            │ #            │
                    &as_l AERO SYMB_L &kp LA(L)   &kp LS(MINUS)  &kp LS(N1)     &kp LS(N2)     &kp LS(BSLH)                                  &kp LA(N)      &kp LS(N6)     &kp RBKT       &kp LS(N0)     &kp LS(N5)     &kp BSLH
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ ^            │ [            │ {            │ (            │ <            │              ││              │ >            │ )            │ }            │ ]            │ *            │              │
                    &trans         &kp NON_US_BSLH &kp LA(N5)    &kp LA(N8)     &kp LS(N8)     &kp GRAVE      &trans          &trans         &kp LS(GRAVE)   &kp LS(N9)     &kp LA(N9)     &kp LA(N6)     &kp LS(RBKT)   &trans
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │              │              ││              │ (HELD)       │              │              │              │
                                                  &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          symbol_locked_layer {
               display-name = "SYMBOLS";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │              │              │              │              │              │              │                              │              │              │              │              │              │ °            │
                    &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &kp LS(NON_US_BSLH)
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ §            │ $            │ €            │ `            │ ´            │                              │ ©            │ /            │ |            │ \            │ —            │ _            │
                    &trans         &kp LS(N3)     &kp LS(N4)     &kp LA(E)      &kp LS(EQUAL)  &kp EQUAL                                     &kp LA(G)      &kp LS(N7)     &kp LA(N7)     &kp LS(LA(N7)) &kp LS(LA(FSLH)) &kp LS(FSLH)
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │ UNLOCK/AERO  │ @            │ ?            │ !            │ "            │ '            │                              │ ~            │ &            │ +            │ =            │ %            │ #            │
                    &as_l AERO SYMB_L &kp LA(L)   &kp LS(MINUS)  &kp LS(N1)     &kp LS(N2)     &kp LS(BSLH)                                  &kp LA(N)      &kp LS(N6)     &kp RBKT       &kp LS(N0)     &kp LS(N5)     &kp BSLH
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┐┌──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
               // │              │ ^            │ [            │ {            │ (            │ <            │              ││              │ >            │ )            │ }            │ ]            │ *            │              │
                    &trans         &kp NON_US_BSLH &kp LA(N5)    &kp LA(N8)     &kp LS(N8)     &kp GRAVE      &trans          &trans         &kp LS(GRAVE)   &kp LS(N9)     &kp LA(N9)     &kp LA(N6)     &kp LS(RBKT)   &trans
               // └──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────┘
               //                               │              │              │              │              │              ││              │ (HELD)       │              │              │              │
                                                  &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
               //                               └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘└──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
               >;
          };

          emoji_layer {
               display-name = "EMOJIS";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │ Exit Emojis  │ 😊           │ 🤗            │ 😂           │ 😅           │ 🥲            │                              │ ❤️           │ 😍           │ 👍🏻            │ 🙈           │ 🤔           │ GLOBE        │
                    &tog EMOJIS    &m_emj1        &m_emj2        &m_emj3        &m_emj4        &m_emj5                                       &m_emj6        &m_emj7        &m_emj8        &m_emj9        &m_emj10       &kp GLOBE
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
                    &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
                    &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
                    &trans         &trans         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans         &trans         &trans
                                                  &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans
               >;
          };

          function1_layer {
               display-name = "F1-10";
               bindings = <
               // ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                              ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
               // │ Exit FUNC1   │ F1           │ F2           │ F3           │ F4           │ F5           │                              │ F6           │ F7           │ F8           │ F9           │ F10          │              │
                    &tog FUNC1     &kp F1         &kp F2         &kp F3         &kp F4         &kp F5                                        &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &trans
               // ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                              ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
                    &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
                    &trans         &trans         &trans         &trans         &trans         &trans                                        &trans         &trans         &trans         &trans         &trans         &trans
                    &trans         &trans         &trans         &trans         &trans         &trans         &trans          &trans         &trans         &trans         &trans         &trans         &trans         &trans
